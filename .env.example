# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas
MONGODB_URI=

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET=nivora_jwt_secret_key_2026

# RAZORPAY_KEY_ID: Razorpay Key ID
RAZORPAY_KEY_ID=rzp_test_THNjQZliCmOmZS

# RAZORPAY_KEY_SECRET: Razorpay Key Secret
RAZORPAY_KEY_SECRET=2vcIFnlWRn5rohfpZHvOyG4i

# VITE_ADMIN_PANEL_URL: URL of the Admin Panel application
VITE_ADMIN_PANEL_URL=

# VITE_API_URL: Base URL of the backend API (e.g. http://localhost:5000)
VITE_API_URL=

# EmailJS Configuration (Frontend)
VITE_EMAILJS_SERVICE_ID=service_73128f7
VITE_EMAILJS_TEMPLATE_ID=template_hiyzzh3
VITE_EMAILJS_CANCELLATION_TEMPLATE_ID=template_uxvtals
VITE_EMAILJS_PUBLIC_KEY=DD1h6Lz08lMuxnirn

